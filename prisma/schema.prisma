// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String             @id
  name              String             @db.Text
  email             String
  emailVerified     Boolean            @default(false)
  image             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  passkeys          Passkey[]
  uploads           Upload[]
  usage             DailyUsage[]
  outputResolutions OutputResolution[]

  @@unique([email])
  @@map("user")
}

enum UploadStatus {
  queued
  processing
  finished
  failed
}

enum ImageKind {
  original
  result
  thumbnail
}

model Upload {
  id              String        @id @db.VarChar(36)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename        String        @db.VarChar(255)
  status          UploadStatus  @default(queued)
  stage           String?       @db.VarChar(40)
  title           String?       @db.VarChar(500)
  author          String?       @db.VarChar(500)
  error           String?       @db.VarChar(500)
  metadataWarning String?       @db.VarChar(500)
  attemptCount    Int           @default(0)
  outputWidth     Int?
  outputHeight    Int?
  processingToken String?       @db.VarChar(36)
  leaseExpiresAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  finishedAt      DateTime?
  images          UploadImage[]

  @@index([userId, createdAt])
  @@index([userId, status, leaseExpiresAt])
}

model OutputResolution {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([userId, width, height])
  @@index([userId])
}

model UploadImage {
  id       String    @id @default(cuid())
  uploadId String    @db.VarChar(36)
  upload   Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  kind     ImageKind
  mimeType String    @db.VarChar(40)
  width    Int
  height   Int
  byteSize Int
  data     Bytes     @db.MediumBlob

  @@unique([uploadId, kind])
}

model DailyUsage {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      String @db.VarChar(10)
  attempts Int    @default(0)

  @@id([userId, day])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String   @db.Text
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique @db.VarChar(512)
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?  @db.Text
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId(length: 191)])
  @@map("passkey")
}
